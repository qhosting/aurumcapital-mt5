//@version=6
indicator("Aurum Vision V15 — señales de investigación", overlay=true, max_boxes_count=40, max_bars_back=1100)
// OHLC confirmation module. Execution, spread, news and account-risk gates belong to MT5.
emaPeriod = input.int(200, "EMA H1/H4", minval=2)
useMTF = input.bool(true, "Exigir H4")
rsiOS = input.int(42, "RSI compra <")
rsiOB = input.int(58, "RSI venta >")
adxMin = input.int(20, "ADX mínimo")
length = input.int(5, "Pivot confirmado", minval=2, maxval=20)
age = input.int(200, "Replay / edad máxima", minval=40, maxval=500)
useOB = input.bool(true, "Admitir OB")
useBreaker = input.bool(true, "Admitir breaker")
requireFVG = input.bool(false, "Exigir FVG adicional")
requireSweep = input.bool(false, "Exigir barrido adicional")
showZones = input.bool(true, "Dibujar zonas (no modifica señales)")
useSession = input.bool(true, "Ventanas CDMX")
useStructureSL = input.bool(true, "SL estructural")
atrMult = input.float(2.0, "SL por ATR", minval=0.1)
goldMin = input.float(10.0, "Oro mínimo ATR")
goldMax = input.float(18.0, "Oro máximo SL")
rr = input.float(2.2, "TP R", minval=0.1)
if timeframe.period != "15"
    runtime.error("Perfil V15 validación: usar M15")

// Last CLOSED HTF candle at signal bar close, including the HTF boundary.
[ePrev, hiPrev, loPrev] = request.security(syminfo.tickerid, "60", [ta.ema(close, emaPeriod)[1], ta.highest(high,20)[1], ta.lowest(low,20)[1]], lookahead=barmerge.lookahead_on)
[eNow, hiNow, loNow] = request.security(syminfo.tickerid, "60", [ta.ema(close, emaPeriod), ta.highest(high,20), ta.lowest(low,20)], lookahead=barmerge.lookahead_off)
hPrev = request.security(syminfo.tickerid, "240", ta.ema(close,emaPeriod)[1], lookahead=barmerge.lookahead_on)
hNow = request.security(syminfo.tickerid, "240", ta.ema(close,emaPeriod), lookahead=barmerge.lookahead_off)
h1Boundary = time_close == time_close("60")
h4Boundary = time_close == time_close("240")
ema = h1Boundary ? eNow : ePrev
htf = h4Boundary ? hNow : hPrev
eq = ((h1Boundary ? hiNow : hiPrev) + (h1Boundary ? loNow : loPrev))/2
rsi = ta.rsi(close,14)
[diPlus,diMinus,adx] = ta.dmi(14,14)
atr = ta.atr(14)

type Zone
    float top
    float bottom
    int born
    bool bull
    bool breaker
    bool fvg
addZone(array<Zone> zs,float top,float bottom,int born,bool bull,bool fvg) =>
    bool seen = false
    if array.size(zs)>0
        for z in zs
            if z.born==born and z.fvg==fvg and z.bull==bull
                seen := true
    if not seen
        if array.size(zs)>=40
            array.shift(zs)
        array.push(zs,Zone.new(top,bottom,born,bull,false,fvg))

array<Zone> zs = array.new<Zone>()
float swingHigh = na
float swingLow = na
bool highBroken = false
bool lowBroken = false
bool sweepBuy = false
bool sweepSell = false
bool ready = bar_index>=age+2*length+4 and not na(htf)
if barstate.isconfirmed and ready
    // Rebuild the same finite causal history as the EA; drawings never feed back.
    for s=age-1 to 0
        int pivot = s+length
        bool sh = true
        bool sl = true
        for j=1 to length
            if high[pivot-j]>=high[pivot] or high[pivot+j]>=high[pivot]
                sh := false
            if low[pivot-j]<=low[pivot] or low[pivot+j]<=low[pivot]
                sl := false
        if sh
            swingHigh := high[pivot]
            highBroken := false
        if sl
            swingLow := low[pivot]
            lowBroken := false
        sweepBuy := not na(swingLow) and low[s]<swingLow and close[s]>=swingLow
        sweepSell := not na(swingHigh) and high[s]>swingHigh and close[s]<=swingHigh
        if array.size(zs)>0
            for j=array.size(zs)-1 to 0
                z = array.get(zs,j)
                bool crossed = z.bull ? close[s]<z.bottom : close[s]>z.top
                bool filled = z.fvg and (z.bull ? low[s]<=z.bottom : high[s]>=z.top)
                if bar_index-s-z.born>age or filled or (crossed and z.breaker)
                    array.remove(zs,j)
                else if crossed and not z.fvg
                    z.breaker := true
                    z.bull := not z.bull
        if not na(swingHigh) and not highBroken and close[s]>swingHigh
            highBroken := true
            for k=s+1 to s+30
                if close[k]<open[k]
                    addZone(zs,high[k],low[k],bar_index-k,true,false)
                    break
        if not na(swingLow) and not lowBroken and close[s]<swingLow
            lowBroken := true
            for k=s+1 to s+30
                if close[k]>open[k]
                    addZone(zs,high[k],low[k],bar_index-k,false,false)
                    break
        if low[s]>high[s+2]
            addZone(zs,low[s],high[s+2],bar_index-s-1,true,true)
        if high[s]<low[s+2]
            addZone(zs,low[s+2],high[s],bar_index-s-1,false,true)

bool bullOB = false
bool bearOB = false
bool bullFVG = false
bool bearFVG = false
float buyEdge = na
float sellEdge = na
if array.size(zs)>0
    for i=array.size(zs)-1 to 0
        z = array.get(zs,i)
        if low<=z.top and high>=z.bottom
            if z.fvg
                bullFVG := bullFVG or z.bull
                bearFVG := bearFVG or not z.bull
            else if (z.breaker and useBreaker) or (not z.breaker and useOB)
                if z.bull
                    if not bullOB
                        buyEdge := z.bottom
                    bullOB := true
                else
                    if not bearOB
                        sellEdge := z.top
                    bearOB := true
int minuteCDMX = hour(time_close,"America/Mexico_City")*60+minute(time_close,"America/Mexico_City")
int dow = dayofweek(time_close,"America/Mexico_City")
bool sessionOK = dow!=dayofweek.saturday and dow!=dayofweek.sunday and (not useSession or (minuteCDMX>=75 and minuteCDMX<330) or (minuteCDMX>=390 and minuteCDMX<690))
span = high-low
paBuy = close>open or (span>0 and (math.min(open,close)-low)/span>=0.30)
paSell = close<open or (span>0 and (high-math.max(open,close))/span>=0.30)
longSignal = barstate.isconfirmed and ready and sessionOK and close>ema and (not useMTF or close>htf) and close<eq and rsi<rsiOS and adx>=adxMin and span>0 and span<=2.8*atr and paBuy and bullOB and (not requireFVG or bullFVG) and (not requireSweep or sweepBuy)
shortSignal = barstate.isconfirmed and ready and sessionOK and close<ema and (not useMTF or close<htf) and close>eq and rsi>rsiOB and adx>=adxMin and span>0 and span<=2.8*atr and paSell and bearOB and (not requireFVG or bearFVG) and (not requireSweep or sweepSell)
plot(ema,"EMA H1 cerrada",color=color.orange)
plot(eq,"Equilibrio 20 H1 cerradas",color=color.gray)
plotshape(longSignal,"Candidato BUY",shape.triangleup,location.belowbar,color.lime,size=size.tiny)
plotshape(shortSignal,"Candidato SELL",shape.triangledown,location.abovebar,color.red,size=size.tiny)
var array<box> drawings = array.new<box>()
if barstate.islast and barstate.isconfirmed
    for b in drawings
        box.delete(b)
    array.clear(drawings)
    if showZones and array.size(zs)>0
        for z in zs
            color c = z.breaker ? color.blue : z.bull ? color.green : color.red
            array.push(drawings,box.new(z.born,z.top,bar_index+5,z.bottom,bgcolor=color.new(c,85),border_color=c))
// Indicative levels exclude broker spread/stops. MT5 must validate executable prices.
bool gold = str.contains(str.upper(syminfo.ticker),"GOLD") or str.contains(str.upper(syminfo.ticker),"XAU")
dist = gold ? math.max(atr*atrMult,goldMin) : atr*atrMult
buySL = useStructureSL ? buyEdge-2*syminfo.mintick : close-dist
sellSL = useStructureSL ? sellEdge+2*syminfo.mintick : close+dist
plot(longSignal and (not gold or close-buySL<=goldMax) ? buySL : shortSignal and (not gold or sellSL-close<=goldMax) ? sellSL : na,"SL orientativo sin spread",color=color.red,style=plot.style_circles)
alertcondition(longSignal,"Aurum V15 BUY candidato","Candidato OHLC BUY {{ticker}}. Validar riesgo, noticias y ejecución en MT5; no es orden.")
alertcondition(shortSignal,"Aurum V15 SELL candidato","Candidato OHLC SELL {{ticker}}. Validar riesgo, noticias y ejecución en MT5; no es orden.")
