{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./staging_station/*"]
    }
  },
  "include": [
    "staging_station/**/*.ts",
    "staging_station/**/*.tsx",
    "staging_station/types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
